MONGODB_URI=mongodb://127.0.0.1:27017/dunderchat
SERVER_PORT=5000

# Where the Next.js client runs. Comma-separate extra origins (e.g. Vercel previews).
CLIENT_URL=http://localhost:3000

# Required in production. Any long random string.
SESSION_SECRET=change-me

# Optional GitHub login. Callback URL: <CLIENT_URL>/api/auth/github/redirect
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional tuning
# GUEST_TTL_HOURS=24
# TRUST_PROXY=1
